# Server Port
PORT=8080

# Database Configuration (PostgreSQL)
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/makanzadb
POSTGRES_USER=makanza_user
POSTGRES_PASSWORD=change-me

# JWT Authentication Secret Key
JWT_SECRET=change-me-to-a-long-random-string

# Optional: If JDBC_DATABASE_URL is not set, server defaults to H2 file DB at ./data/makanzadb
